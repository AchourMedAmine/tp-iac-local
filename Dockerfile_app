# Image de base très légère
FROM alpine:latest

# Installation de Nginx + dossiers nécessaires + logs vers stdout/stderr
RUN apk add --no-cache nginx \
    && mkdir -p /run/nginx /var/www/localhost/htdocs \
    && ln -sf /dev/stdout /var/log/nginx/access.log \
    && ln -sf /dev/stderr /var/log/nginx/error.log

# Remplace le site par défaut d'Alpine (qui renvoie 404 partout)
RUN printf 'server {\n    listen 80 default_server;\n    root /var/www/localhost/htdocs;\n    index index.html;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\n' \
    > /etc/nginx/http.d/default.conf

# Page HTML de preuve
RUN echo "<h1>Application Deployed via Terraform IaC!</h1>" \
    > /var/www/localhost/htdocs/index.html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
